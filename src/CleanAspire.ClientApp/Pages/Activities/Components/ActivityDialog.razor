@using System.Net.Http.Json
@using CleanAspire.ClientApp.DTOs
@using CleanAspire.ClientApp.Services.Activities

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ActivityServiceProxy ActivityServiceProxy

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_formIsValid">
            <MudGrid Spacing="3">
                <!-- Subject -->
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_model.Subject"
                                  Label="@L["Subject"]"
                                  Required="true"
                                  RequiredError="@L["Subject is required"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <!-- Type and Priority Row -->
                <MudItem xs="12" md="6">
                    <MudSelect T="ActivityType"
                               @bind-Value="_model.Type"
                               Label="@L["Type"]"
                               Required="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Task">@L["Task"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.PhoneCall">@L["Phone Call"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Meeting">@L["Meeting"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.FollowUp">@L["Follow Up"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Email">@L["Email"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.WhatsAppMessage">@L["WhatsApp Message"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.WhatsAppFlow">@L["WhatsApp Flow"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.SMS">@L["SMS"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.InstagramDM">@L["Instagram DM"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.FacebookMessage">@L["Facebook Message"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.LinkedInMessage">@L["LinkedIn Message"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.TwitterDM">@L["Twitter DM"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.VideoCall">@L["Video Call"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.WebChat">@L["Web Chat"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Chatbot">@L["Chatbot"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Event">@L["Event"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Webinar">@L["Webinar"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Presentation">@L["Presentation"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Workshop">@L["Workshop"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Newsletter">@L["Newsletter"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Campaign">@L["Campaign"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Survey">@L["Survey"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Note">@L["Note"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Document">@L["Document"]</MudSelectItem>
                        <MudSelectItem T="ActivityType" Value="@ActivityType.Other">@L["Other"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               @bind-Value="_priorityString"
                               Label="@L["Priority"]"
                               Required="true"
                               Variant="Variant.Outlined"
                               @bind-Value:after="OnPriorityChanged">
                        <MudSelectItem Value="1">@L["Low"]</MudSelectItem>
                        <MudSelectItem Value="2">@L["Normal"]</MudSelectItem>
                        <MudSelectItem Value="3">@L["High"]</MudSelectItem>
                        <MudSelectItem Value="4">@L["Urgent"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Status -->
                <MudItem xs="12" md="6">
                    <MudSelect T="ActivityStatus"
                               @bind-Value="_model.Status"
                               Label="@L["Status"]"
                               Required="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Open">@L["Open"]</MudSelectItem>
                        <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.InProgress">@L["In Progress"]</MudSelectItem>
                        <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Completed">@L["Completed"]</MudSelectItem>
                        <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Canceled">@L["Canceled"]</MudSelectItem>
                        <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Deferred">@L["Deferred"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <!-- Duration -->
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?"
                                     @bind-Value="_model.DurationMinutes"
                                     Label="@L["Duration (minutes)"]"
                                     Min="0"
                                     Variant="Variant.Outlined" />
                </MudItem>

                <!-- Start Date and Due Date -->
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_startDate"
                                   Label="@L["Start Date"]"
                                   Required="true"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_dueDate"
                                   Label="@L["Due Date"]"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <!-- Reminder -->
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_reminderDate"
                                   Label="@L["Reminder Date"]"
                                   Variant="Variant.Outlined" />
                </MudItem>

                <!-- Location -->
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="_model.Location"
                                  Label="@L["Location"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <!-- Regarding Type and ID -->
                <MudItem xs="12" md="6">
                    <MudSelect T="RegardingType?"
                               Value="_model.RegardingType"
                               ValueChanged="@((RegardingType? val) => _model.RegardingType = val)"
                               Label="@L["Regarding Type"]"
                               Clearable="true"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)null)">@L["None"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Client)">@L["Client"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Contact)">@L["Contact"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Opportunity)">@L["Opportunity"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Case)">@L["Case"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Lead)">@L["Lead"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Campaign)">@L["Campaign"]</MudSelectItem>
                        <MudSelectItem T="RegardingType?" Value="@((RegardingType?)RegardingType.Project)">@L["Project"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  @bind-Value="_regardingIdString"
                                  Label="@L["Regarding ID (GUID)"]"
                                  Variant="Variant.Outlined"
                                  Disabled="!_model.RegardingType.HasValue"
                                  HelperText="@(_model.RegardingType.HasValue ? @L["Enter the GUID of the related entity"] : @L["Select a Regarding Type first"])" />
                </MudItem>

                <!-- Assigned To -->
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_model.AssignedToUserId"
                                  Label="@L["Assigned To User ID"]"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["Leave empty to assign to yourself"]" />
                </MudItem>

                <!-- Description -->
                <MudItem xs="12">
                    <MudTextField T="string"
                                  @bind-Value="_model.Description"
                                  Label="@L["Description"]"
                                  Lines="5"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="!_formIsValid || _saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsEdit ? @L["Update"] : @L["Create"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool IsEdit { get; set; } = false;
    [Parameter] public ActivityDto? Activity { get; set; }
    [Parameter] public RegardingType? Regarding { get; set; }
    [Parameter] public Guid? RegardingId { get; set; }

    private MudForm _form = null!;
    private bool _formIsValid = false;
    private bool _saving = false;
    private ActivityRequest _model = new();
    private DateTime? _startDate;
    private DateTime? _dueDate;
    private DateTime? _reminderDate;
    private string _regardingIdString = string.Empty;
    private string _priorityString = "2"; // Default to Normal

    protected override void OnInitialized()
    {
        if (IsEdit && Activity != null)
        {
            // Edit mode - populate from existing activity
            _model = new ActivityRequest
            {
                Type = Activity.Type,
                Status = Activity.Status,
                Start = Activity.Start,
                Due = Activity.Due,
                Subject = Activity.Subject,
                Description = Activity.Description,
                RegardingType = Activity.RegardingType,
                RegardingId = Activity.RegardingId,
                AssignedToUserId = Activity.AssignedToUserId,
                ReminderAt = Activity.ReminderAt,
                Priority = Activity.Priority,
                Location = Activity.Location,
                DurationMinutes = Activity.DurationMinutes
            };

            _startDate = Activity.Start;
            _dueDate = Activity.Due;
            _reminderDate = Activity.ReminderAt;
            _regardingIdString = Activity.RegardingId?.ToString() ?? string.Empty;
            _priorityString = ((int)Activity.Priority).ToString();
        }
        else
        {
            // Create mode - set defaults
            _model = new ActivityRequest
            {
                Type = ActivityType.Task,
                Status = ActivityStatus.Open,
                Start = DateTime.UtcNow,
                Priority = ActivityPriority.Normal,
                RegardingType = Regarding,
                RegardingId = RegardingId
            };

            _startDate = DateTime.UtcNow;

            if (RegardingId.HasValue)
            {
                _regardingIdString = RegardingId.Value.ToString();
            }
        }
    }

    private async Task Submit()
    {
        await _form.Validate();

        if (!_formIsValid)
        {
            Snackbar.Add(@L["Please fix validation errors"], Severity.Error);
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            // Update dates from date pickers
            if (_startDate.HasValue)
            {
                // Combine date with current time if no time component
                var startDate = _startDate.Value;
                if (startDate.TimeOfDay == TimeSpan.Zero)
                {
                    // If only date is set (time is 00:00), use current time
                    startDate = startDate.Date.Add(DateTime.Now.TimeOfDay);
                }
                _model.Start = startDate;
            }

            // For due date, if it's the same day as start, add time offset
            if (_dueDate.HasValue)
            {
                var dueDate = _dueDate.Value;
                if (dueDate.TimeOfDay == TimeSpan.Zero)
                {
                    // If only date is set, add 1 hour to ensure it's after start
                    dueDate = dueDate.Date.Add(_model.Start.TimeOfDay).AddHours(1);
                }
                _model.Due = dueDate;
            }
            else
            {
                _model.Due = null;
            }

            _model.ReminderAt = _reminderDate;

            // Parse regarding ID if provided
            if (!string.IsNullOrEmpty(_regardingIdString) && Guid.TryParse(_regardingIdString, out var regardingGuid))
            {
                _model.RegardingId = regardingGuid;
            }
            else
            {
                _model.RegardingId = null;
            }

            bool success;
            if (IsEdit && Activity != null)
            {
                success = await ActivityServiceProxy.UpdateActivityAsync(Activity.Id, _model);
            }
            else
            {
                var result = await ActivityServiceProxy.CreateActivityAsync(_model);
                success = result != null;
            }

            if (success)
            {
                Snackbar.Add(IsEdit ? @L["Activity updated successfully"] : @L["Activity created successfully"], Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(IsEdit ? @L["Failed to update activity"] : @L["Failed to create activity"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(@L["Error: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void OnPriorityChanged()
    {
        if (int.TryParse(_priorityString, out var priorityValue))
        {
            _model.Priority = (ActivityPriority)priorityValue;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
