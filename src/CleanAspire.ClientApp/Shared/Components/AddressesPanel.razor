@using System.Net.Http.Json
@using CleanAspire.ClientApp.DTOs

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-4" Elevation="2">
    <!-- Header -->
    <MudStack Row Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
            <MudText Typo="Typo.h6">@Title</MudText>
            @if (_addresses.Any())
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@_addresses.Count</MudChip>
            }
        </MudStack>
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog"
                       Size="Size.Small"
                       Color="Color.Primary"
                       Title="Add Address" />
    </MudStack>

    <!-- Addresses Content -->
    <div style="max-height: 600px; overflow-y: auto;">
        @if (_loading && !_addresses.Any())
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Loading addresses...</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Error loading addresses: @_error
            </MudAlert>
        }
        else if (!_addresses.Any())
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.h6">No addresses found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    Addresses will appear here as they are created
                </MudText>
            </MudStack>
        }
        else
        {
            @foreach (var address in _addresses.OrderByDescending(a => a.IsPrimary).ThenByDescending(a => a.Created))
            {
                <MudPaper Class="pa-3 mb-2" Elevation="1">
                    <MudStack Spacing="2">
                        <!-- Header -->
                        <MudStack Row Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Spacing="1" Style="flex: 1;">
                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                    @if (address.IsPrimary)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primary</MudChip>
                                    }
                                    @if (!string.IsNullOrEmpty(address.Label))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@address.Label</MudChip>
                                    }
                                </MudStack>

                                <!-- Address Lines -->
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@address.Line1</MudText>
                                    @if (!string.IsNullOrEmpty(address.Line2))
                                    {
                                        <MudText Typo="Typo.body2">@address.Line2</MudText>
                                    }
                                    @if (!string.IsNullOrEmpty(address.District))
                                    {
                                        <MudText Typo="Typo.body2">@address.District</MudText>
                                    }
                                    <MudText Typo="Typo.body2">
                                        @address.City, @address.State @address.Zip
                                    </MudText>
                                    <MudText Typo="Typo.body2">@GetCountryName(address.Country)</MudText>
                                </MudStack>
                            </MudStack>
                        </MudStack>

                        <!-- Actions -->
                        <MudStack Row Spacing="1" Justify="Justify.FlexEnd">
                            @if (!address.IsPrimary)
                            {
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => SetPrimary(address.Id))"
                                           StartIcon="@Icons.Material.Filled.Star">
                                    Set Primary
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(address))"
                                       StartIcon="@Icons.Material.Filled.Edit">
                                Edit
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAddress(address.Id))"
                                       StartIcon="@Icons.Material.Filled.Delete">
                                Delete
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        }
    </div>
</MudPaper>

@code {
    /// <summary>
    /// Type of entity (Client, Contact, etc.) - Required
    /// </summary>
    [Parameter, EditorRequired]
    public OwnerType OwnerType { get; set; }

    /// <summary>
    /// ID of the entity - Required
    /// </summary>
    [Parameter, EditorRequired]
    public Guid OwnerId { get; set; }

    /// <summary>
    /// Panel title (default: "Addresses")
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Addresses";

    // State
    private List<AddressDto> _addresses = new();
    private bool _loading = false;
    private string? _error = null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAddresses();
    }

    private async Task LoadAddresses()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var url = $"/api/crm/addresses/owner/{OwnerType}/{OwnerId}";
            var response = await Http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                _error = $"API returned {response.StatusCode}";
                return;
            }

            _addresses = await response.Content.ReadFromJsonAsync<List<AddressDto>>() ?? new();
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"Error loading addresses: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "OwnerType", OwnerType },
            { "OwnerId", OwnerId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddressDialog>("Create Address", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadAddresses();
        }
    }

    private async Task OpenEditDialog(AddressDto address)
    {
        var parameters = new DialogParameters
        {
            { "Address", address }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddressDialog>("Edit Address", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadAddresses();
        }
    }

    private async Task SetPrimary(Guid addressId)
    {
        try
        {
            var response = await Http.PostAsync($"/api/crm/addresses/{addressId}/set-primary", null);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Primary address updated", Severity.Success);
                await LoadAddresses();
            }
            else
            {
                Snackbar.Add($"Failed to set primary address: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error setting primary address: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAddress(Guid addressId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            "Are you sure you want to delete this address?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/crm/addresses/{addressId}");

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Address deleted successfully", Severity.Success);
                    await LoadAddresses();
                }
                else
                {
                    Snackbar.Add($"Failed to delete address: {response.StatusCode}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting address: {ex.Message}", Severity.Error);
            }
        }
    }

    private string GetCountryName(string countryCode)
    {
        return countryCode.ToUpperInvariant() switch
        {
            "BR" => "Brazil",
            "US" => "United States",
            "CA" => "Canada",
            "MX" => "Mexico",
            "AR" => "Argentina",
            "CL" => "Chile",
            "CO" => "Colombia",
            "PE" => "Peru",
            "UY" => "Uruguay",
            "PY" => "Paraguay",
            "BO" => "Bolivia",
            "EC" => "Ecuador",
            "VE" => "Venezuela",
            "GB" => "United Kingdom",
            "DE" => "Germany",
            "FR" => "France",
            "IT" => "Italy",
            "ES" => "Spain",
            "PT" => "Portugal",
            _ => countryCode
        };
    }

    /// <summary>
    /// Public method to refresh addresses (can be called from parent)
    /// </summary>
    public async Task RefreshAddresses()
    {
        await LoadAddresses();
    }
}

@* Placeholder for Address Dialog Component *@
@code {
    private class AddressDialog : ComponentBase
    {
        [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
        [Parameter] public OwnerType OwnerType { get; set; }
        [Parameter] public Guid OwnerId { get; set; }
        [Parameter] public AddressDto? Address { get; set; }
    }
}
