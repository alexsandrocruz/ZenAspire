@using System.Net.Http.Json
@using CleanAspire.ClientApp.DTOs

@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-4" Elevation="2">
    <!-- Header -->
    <MudStack Row Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.StickyNote2" />
            <MudText Typo="Typo.h6">@Title</MudText>
            @if (_notes.Any())
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@_totalCount</MudChip>
            }
        </MudStack>
        <MudStack Row Spacing="1">
            @if (_notes.Any())
            {
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search notes..."
                              Variant="Variant.Outlined"
                              Dense="true"
                              Immediate="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="max-width: 200px;" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Title="Add Note" />
        </MudStack>
    </MudStack>

    <!-- Notes Content -->
    <div style="max-height: 600px; overflow-y: auto;">
        @if (_loading && !_notes.Any())
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2">Loading notes...</MudText>
            </MudStack>
        }
        else if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Error loading notes: @_error
            </MudAlert>
        }
        else if (!GetFilteredNotes().Any())
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-8">
                <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(_searchText) ? "No notes found" : "No matching notes")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">
                    @(string.IsNullOrWhiteSpace(_searchText) ? "Notes will appear here as they are created" : "Try a different search term")
                </MudText>
            </MudStack>
        }
        else
        {
            <!-- Pinned Notes Section -->
            @if (GetPinnedNotes().Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                    <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" /> Pinned
                </MudText>
                @foreach (var note in GetPinnedNotes())
                {
                    @RenderNote(note)
                }
            }

            @if (GetRegularNotes().Any())
            {
                @if (GetPinnedNotes().Any())
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4" Style="font-weight: 600;">Notes</MudText>
                }
                @foreach (var note in GetRegularNotes())
                {
                    @RenderNote(note)
                }
            }

            <!-- Load More Button -->
            @if (_hasMorePages)
            {
                <MudStack AlignItems="AlignItems.Center" Class="mt-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="LoadMore"
                               Disabled="@_loading">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        }
                        Load More
                    </MudButton>
                </MudStack>
            }
        }
    </div>
</MudPaper>

@code {
    /// <summary>
    /// Type of entity (Client, Contact, etc.) - Required
    /// </summary>
    [Parameter, EditorRequired]
    public OwnerType OwnerType { get; set; }

    /// <summary>
    /// ID of the entity - Required
    /// </summary>
    [Parameter, EditorRequired]
    public Guid OwnerId { get; set; }

    /// <summary>
    /// Panel title (default: "Notes")
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Notes";

    /// <summary>
    /// Items per page (default: 10)
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    // State
    private List<NoteDto> _notes = new();
    private bool _loading = false;
    private string? _error = null;
    private int _currentPage = 1;
    private int _totalCount = 0;
    private bool _hasMorePages = false;
    private string _searchText = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _notes.Clear();
        _currentPage = 1;
        _error = null;
        await LoadNotes();
    }

    private async Task LoadNotes()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>
            {
                $"pageNumber={_currentPage}",
                $"pageSize={PageSize}"
            };

            var url = $"/api/crm/notes/owner/{OwnerType}/{OwnerId}?{string.Join("&", queryParams)}";
            var response = await Http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                _error = $"API returned {response.StatusCode}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<PaginatedResult<NoteDto>>();

            if (result != null)
            {
                _notes.AddRange(result.Items ?? Enumerable.Empty<NoteDto>());
                _totalCount = result.TotalCount;
                _hasMorePages = result.PageNumber < result.TotalPages;
            }

            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Snackbar.Add($"Error loading notes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMore()
    {
        _currentPage++;
        await LoadNotes();
    }

    private IEnumerable<NoteDto> GetFilteredNotes()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return _notes;

        return _notes.Where(n =>
            (n.Title?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            n.Body.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
    }

    private List<NoteDto> GetPinnedNotes()
    {
        return GetFilteredNotes().Where(n => n.IsPinned).ToList();
    }

    private List<NoteDto> GetRegularNotes()
    {
        return GetFilteredNotes().Where(n => !n.IsPinned).ToList();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "OwnerType", OwnerType },
            { "OwnerId", OwnerId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NoteDialog>("Create Note", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _notes.Clear();
            _currentPage = 1;
            await LoadNotes();
        }
    }

    private async Task OpenEditDialog(NoteDto note)
    {
        var parameters = new DialogParameters
        {
            { "Note", note }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NoteDialog>("Edit Note", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _notes.Clear();
            _currentPage = 1;
            await LoadNotes();
        }
    }

    private async Task TogglePin(Guid noteId)
    {
        var note = _notes.FirstOrDefault(n => n.Id == noteId);
        if (note == null) return;

        try
        {
            var request = new NoteRequest
            {
                OwnerType = note.OwnerType,
                OwnerId = note.OwnerId,
                Title = note.Title,
                Body = note.Body,
                IsPinned = !note.IsPinned,
                IsPrivate = note.IsPrivate
            };

            var response = await Http.PutAsJsonAsync($"/api/crm/notes/{noteId}", request);

            if (response.IsSuccessStatusCode)
            {
                note.IsPinned = !note.IsPinned;
                Snackbar.Add($"Note {(note.IsPinned ? "pinned" : "unpinned")}", Severity.Success);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add($"Failed to update note: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating note: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteNote(Guid noteId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            "Are you sure you want to delete this note?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"/api/crm/notes/{noteId}");

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Note deleted successfully", Severity.Success);
                    _notes.Clear();
                    _currentPage = 1;
                    await LoadNotes();
                }
                else
                {
                    Snackbar.Add($"Failed to delete note: {response.StatusCode}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting note: {ex.Message}", Severity.Error);
            }
        }
    }

    private RenderFragment RenderNote(NoteDto note) => __builder =>
    {
        <MudPaper Class="pa-3 mb-2" Elevation="1">
            <MudStack Spacing="2">
                <!-- Header -->
                <MudStack Row Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <MudStack Spacing="1" Style="flex: 1;">
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            @if (note.IsPinned)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Warning" />
                            }
                            @if (note.IsPrivate)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" />
                            }
                            @if (!string.IsNullOrEmpty(note.Title))
                            {
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@note.Title</MudText>
                            }
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Default" Style="white-space: pre-wrap;">@note.Body</MudText>
                    </MudStack>
                </MudStack>

                <!-- Metadata -->
                <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            @GetRelativeTime(note.Created)
                        </MudText>
                        @if (!string.IsNullOrEmpty(note.CreatedBy))
                        {
                            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                <MudText Typo="Typo.caption">@note.CreatedBy</MudText>
                            </MudStack>
                        }
                    </MudStack>

                    <!-- Actions -->
                    <MudStack Row Spacing="1">
                        <MudIconButton Icon="@(note.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                       Size="Size.Small"
                                       Color="@(note.IsPinned ? Color.Warning : Color.Default)"
                                       OnClick="@(() => TogglePin(note.Id))"
                                       Title="@(note.IsPinned ? "Unpin" : "Pin")" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(note))"
                                       Title="Edit" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteNote(note.Id))"
                                       Title="Delete" />
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>
    };

    private string GetRelativeTime(DateTime date)
    {
        var timeSpan = DateTime.UtcNow - date;

        if (timeSpan.TotalSeconds < 60)
            return "Just now";

        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} minutes ago";

        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} hours ago";

        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays} days ago";

        if (timeSpan.TotalDays < 30)
            return $"{(int)(timeSpan.TotalDays / 7)} weeks ago";

        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} months ago";

        return date.ToString("MMM d, yyyy");
    }
}

@* Placeholder for Note Dialog Component *@
@code {
    private class NoteDialog : ComponentBase
    {
        [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
        [Parameter] public OwnerType OwnerType { get; set; }
        [Parameter] public Guid OwnerId { get; set; }
        [Parameter] public NoteDto? Note { get; set; }
    }
}
