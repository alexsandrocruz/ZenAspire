@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@GetActivityIcon(_model.Type)" Class="mr-3" />
            @(Activity != null ? "Edit Activity" : "New Activity")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors">
            <MudStack Spacing="3">
                <!-- Activity Type and Subject -->
                <MudSelect T="ActivityType"
                           @bind-Value="_model.Type"
                           Label="Activity Type *"
                           Required="true"
                           RequiredError="Activity type is required"
                           Variant="Variant.Outlined">
                    @foreach (ActivityType type in Enum.GetValues(typeof(ActivityType)))
                    {
                        <MudSelectItem T="ActivityType" Value="@type">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@GetActivityIcon(type)" Size="Size.Small" />
                                <MudText>@GetActivityTypeName(type)</MudText>
                            </MudStack>
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudTextField T="string"
                              @bind-Value="_model.Subject"
                              Label="Subject *"
                              Required="true"
                              RequiredError="Subject is required"
                              MaxLength="160"
                              Counter="160"
                              Immediate="true"
                              Variant="Variant.Outlined" />

                <!-- Priority and Status -->
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   @bind-Value="_priorityString"
                                   Label="Priority *"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   @bind-Value:after="OnPriorityChanged">
                            <MudSelectItem Value="1">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Color="Color.Info" Size="Size.Small" />
                                    <MudText>Low</MudText>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="2">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                                    <MudText>Normal</MudText>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="3">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Color="Color.Warning" Size="Size.Small" />
                                    <MudText>High</MudText>
                                </MudStack>
                            </MudSelectItem>
                            <MudSelectItem Value="4">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" />
                                    <MudText>Urgent</MudText>
                                </MudStack>
                            </MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="ActivityStatus"
                                   @bind-Value="_model.Status"
                                   Label="Status *"
                                   Required="true"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Open">Open</MudSelectItem>
                            <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.InProgress">In Progress</MudSelectItem>
                            <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Completed">Completed</MudSelectItem>
                            <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Canceled">Canceled</MudSelectItem>
                            <MudSelectItem T="ActivityStatus" Value="@ActivityStatus.Deferred">Deferred</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <!-- Start and Due Date/Time -->
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_startDate"
                                       Label="Start Date *"
                                       Required="true"
                                       RequiredError="Start date is required"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTimePicker @bind-Time="_startTime"
                                       Label="Start Time *"
                                       Required="true"
                                       RequiredError="Start time is required"
                                       Variant="Variant.Outlined"
                                       AmPm="false" />
                    </MudItem>
                </MudGrid>

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_dueDate"
                                       Label="Due Date"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTimePicker @bind-Time="_dueTime"
                                       Label="Due Time"
                                       Variant="Variant.Outlined"
                                       AmPm="false"
                                       Clearable="true"
                                       Disabled="@(_dueDate == null)" />
                    </MudItem>
                </MudGrid>

                <!-- Duration and Location -->
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int?"
                                         @bind-Value="_model.DurationMinutes"
                                         Label="Duration (minutes)"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="1440"
                                         Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      @bind-Value="_model.Location"
                                      Label="Location"
                                      MaxLength="200"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <!-- Description -->
                <MudTextField T="string"
                              @bind-Value="_model.Description"
                              Label="Description"
                              Lines="4"
                              MaxLength="2000"
                              Counter="2000"
                              Immediate="true"
                              Variant="Variant.Outlined" />

                <!-- Assigned To -->
                <MudTextField T="string"
                              @bind-Value="_model.AssignedToUserId"
                              Label="Assigned To (User ID)"
                              Variant="Variant.Outlined"
                              HelperText="Optional: Enter user ID to assign this activity" />

                <!-- Reminder -->
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudDatePicker @bind-Date="_reminderDate"
                                       Label="Reminder Date"
                                       Variant="Variant.Outlined"
                                       DateFormat="dd/MM/yyyy"
                                       Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTimePicker @bind-Time="_reminderTime"
                                       Label="Reminder Time"
                                       Variant="Variant.Outlined"
                                       AmPm="false"
                                       Clearable="true"
                                       Disabled="@(_reminderDate == null)" />
                    </MudItem>
                </MudGrid>

                @if (_errors?.Length > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @foreach (var error in _errors)
                        {
                            <MudText Typo="Typo.body2">@error</MudText>
                        }
                    </MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_success || _isSubmitting)">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Cascading parameter for MudDialog instance
    /// </summary>
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Activity to edit. If null, creates a new activity.
    /// </summary>
    [Parameter]
    public ActivityDto? Activity { get; set; }

    /// <summary>
    /// Required for create mode: Type of entity this activity is related to
    /// </summary>
    [Parameter]
    public RegardingType RegardingType { get; set; }

    /// <summary>
    /// Required for create mode: ID of the entity this activity is related to
    /// </summary>
    [Parameter]
    public Guid RegardingId { get; set; }

    private MudForm? _form;
    private bool _success = false;
    private string[] _errors = Array.Empty<string>();
    private bool _isSubmitting = false;
    private ActivityRequest _model = new();

    // Separate date/time fields for better UX
    private DateTime? _startDate = DateTime.Today;
    private TimeSpan? _startTime = DateTime.Now.TimeOfDay;
    private DateTime? _dueDate;
    private TimeSpan? _dueTime;
    private DateTime? _reminderDate;
    private TimeSpan? _reminderTime;
    private string _priorityString = "2"; // Default to Normal

    protected override void OnInitialized()
    {
        if (Activity != null)
        {
            // Edit mode - populate from existing activity
            _model = new ActivityRequest
            {
                Type = Activity.Type,
                Status = Activity.Status,
                Subject = Activity.Subject,
                Description = Activity.Description,
                Priority = Activity.Priority,
                Location = Activity.Location,
                DurationMinutes = Activity.DurationMinutes,
                AssignedToUserId = Activity.AssignedToUserId,
                RegardingType = Activity.RegardingType,
                RegardingId = Activity.RegardingId
            };

            // Initialize priority string
            _priorityString = ((int)Activity.Priority).ToString();

            // Split Start into date and time
            _startDate = Activity.Start.Date;
            _startTime = Activity.Start.TimeOfDay;

            // Split Due into date and time if exists
            if (Activity.Due.HasValue)
            {
                _dueDate = Activity.Due.Value.Date;
                _dueTime = Activity.Due.Value.TimeOfDay;
            }

            // Split ReminderAt into date and time if exists
            if (Activity.ReminderAt.HasValue)
            {
                _reminderDate = Activity.ReminderAt.Value.Date;
                _reminderTime = Activity.ReminderAt.Value.TimeOfDay;
            }
        }
        else
        {
            // Create mode - set defaults
            _model.Type = ActivityType.Task;
            _model.Status = ActivityStatus.Open;
            _model.Priority = ActivityPriority.Normal;
            _model.RegardingType = RegardingType;
            _model.RegardingId = RegardingId;
            _model.Start = DateTime.Now;

            _startDate = DateTime.Today;
            _startTime = DateTime.Now.TimeOfDay;
        }
    }

    /// <summary>
    /// Validates and submits the activity form
    /// </summary>
    private async Task Submit()
    {
        if (_form == null || !_form.IsValid)
        {
            Snackbar.Add("Please correct the validation errors", Severity.Error);
            return;
        }

        // Combine date and time fields
        if (_startDate.HasValue && _startTime.HasValue)
        {
            _model.Start = _startDate.Value.Date + _startTime.Value;
        }
        else
        {
            Snackbar.Add("Start date and time are required", Severity.Error);
            return;
        }

        if (_dueDate.HasValue && _dueTime.HasValue)
        {
            _model.Due = _dueDate.Value.Date + _dueTime.Value;

            // Validate that due date is after start date
            if (_model.Due.Value < _model.Start)
            {
                Snackbar.Add("Due date must be after start date", Severity.Error);
                return;
            }
        }
        else if (_dueDate.HasValue)
        {
            _model.Due = _dueDate.Value.Date;
        }

        if (_reminderDate.HasValue && _reminderTime.HasValue)
        {
            _model.ReminderAt = _reminderDate.Value.Date + _reminderTime.Value;
        }
        else if (_reminderDate.HasValue)
        {
            _model.ReminderAt = _reminderDate.Value.Date;
        }

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            // Return the request model to the caller
            MudDialog.Close(DialogResult.Ok(_model));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"An error occurred: {ex.Message}", Severity.Error);
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Cancels the dialog
    /// </summary>
    private void OnPriorityChanged()
    {
        if (int.TryParse(_priorityString, out var priorityValue))
        {
            _model.Priority = (ActivityPriority)priorityValue;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    /// <summary>
    /// Gets the Material Design icon for an activity type
    /// </summary>
    private string GetActivityIcon(ActivityType type) => type switch
    {
        ActivityType.Task => Icons.Material.Filled.Task,
        ActivityType.PhoneCall => Icons.Material.Filled.Phone,
        ActivityType.Meeting => Icons.Material.Filled.Groups,
        ActivityType.FollowUp => Icons.Material.Filled.Flag,
        ActivityType.Email => Icons.Material.Filled.Email,
        ActivityType.WhatsAppMessage => Icons.Material.Filled.Chat,
        ActivityType.WhatsAppFlow => Icons.Material.Filled.Autorenew,
        ActivityType.SMS => Icons.Material.Filled.Sms,
        ActivityType.InstagramDM => Icons.Material.Filled.Forum,
        ActivityType.FacebookMessage => Icons.Material.Filled.Forum,
        ActivityType.LinkedInMessage => Icons.Material.Filled.BusinessCenter,
        ActivityType.TwitterDM => Icons.Material.Filled.Message,
        ActivityType.VideoCall => Icons.Material.Filled.VideoCall,
        ActivityType.WebChat => Icons.Material.Filled.Chat,
        ActivityType.Chatbot => Icons.Material.Filled.SmartToy,
        ActivityType.Event => Icons.Material.Filled.Event,
        ActivityType.Webinar => Icons.Material.Filled.CastForEducation,
        ActivityType.Presentation => Icons.Material.Filled.Slideshow,
        ActivityType.Workshop => Icons.Material.Filled.School,
        ActivityType.Newsletter => Icons.Material.Filled.Newspaper,
        ActivityType.Campaign => Icons.Material.Filled.Campaign,
        ActivityType.Survey => Icons.Material.Filled.Poll,
        ActivityType.Note => Icons.Material.Filled.Note,
        ActivityType.Document => Icons.Material.Filled.Description,
        ActivityType.Other => Icons.Material.Filled.MoreHoriz,
        _ => Icons.Material.Filled.Task
    };

    /// <summary>
    /// Gets user-friendly name for activity type
    /// </summary>
    private string GetActivityTypeName(ActivityType type) => type switch
    {
        ActivityType.Task => "Task",
        ActivityType.PhoneCall => "Phone Call",
        ActivityType.Meeting => "Meeting",
        ActivityType.FollowUp => "Follow Up",
        ActivityType.Email => "Email",
        ActivityType.WhatsAppMessage => "WhatsApp Message",
        ActivityType.WhatsAppFlow => "WhatsApp Flow",
        ActivityType.SMS => "SMS",
        ActivityType.InstagramDM => "Instagram DM",
        ActivityType.FacebookMessage => "Facebook Message",
        ActivityType.LinkedInMessage => "LinkedIn Message",
        ActivityType.TwitterDM => "Twitter DM",
        ActivityType.VideoCall => "Video Call",
        ActivityType.WebChat => "Web Chat",
        ActivityType.Chatbot => "Chatbot",
        ActivityType.Event => "Event",
        ActivityType.Webinar => "Webinar",
        ActivityType.Presentation => "Presentation",
        ActivityType.Workshop => "Workshop",
        ActivityType.Newsletter => "Newsletter",
        ActivityType.Campaign => "Campaign",
        ActivityType.Survey => "Survey",
        ActivityType.Note => "Note",
        ActivityType.Document => "Document",
        ActivityType.Other => "Other",
        _ => type.ToString()
    };
}
